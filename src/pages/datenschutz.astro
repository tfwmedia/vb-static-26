---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, site } from '../data/site';
import { loadLegalHtml } from '../lib/legal';

const legal = loadLegalHtml('datenschutz');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Datenschutz', item: absoluteUrl('/datenschutz/') },
      ],
    },
  ],
};
---

<BaseLayout
  meta={{
    title: `Datenschutzerklärung | ${site.name}`,
    description:
      'Datenschutzerklärung der Volksbühne Worms 1908 e. V.: Umgang mit personenbezogenen Daten, Betroffenenrechte und Kontaktdaten des Datenschutzbeauftragten.',
    canonicalPath: '/datenschutz/',
    ogImage: '/assets/img/og-image.png',
    ogImageAlt: site.name,
  }}
  bodyClass="page-datenschutz"
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Datenschutz' },
  ]}
  structuredData={structuredData}
>
  <section class="hero-inner" aria-labelledby="datenschutz-h1">
    <div class="container container--narrow" data-reveal>
      <p class="eyebrow">Rechtliches</p>
      <h1 id="datenschutz-h1">Datenschutzerklärung</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow legal" data-reveal set:html={legal} />
  </section>
</BaseLayout>
