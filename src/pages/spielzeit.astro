---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductionCard from '../components/ProductionCard.astro';
import ScheduleList from '../components/ScheduleList.astro';
import { absoluteUrl, site } from '../data/site';
import { productions } from '../data/productions';
import { upcomingEvents, type VbEvent } from '../data/events';
import { slugify } from '../lib/format';

const description =
  'Spielzeit 2026 der Volksbühne Worms: das Saisonstück "Die Löffelliste" und das Weihnachtsmärchen "Die Bremer Stadtmusikanten" — Tickets über Ticket-Regional.';

// Termine je Produktion gruppieren (Reihenfolge = Datenreihenfolge, 1:1)
const groups = productions.map((p) => ({
  title: p.title,
  venue: p.kind === 'maerchen'
    ? 'Das Wormser, Rathenaustraße 11'
    : 'Volksbühne — kleines Theater, Würdtweinstraße 11',
  events: upcomingEvents.filter((e: VbEvent) => e.title === p.title),
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Spielzeit 2026',
      description,
      url: absoluteUrl('/spielzeit/'),
      isPartOf: { '@id': absoluteUrl('/') + '#website' },
      publisher: { '@id': absoluteUrl('/') + '#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Spielzeit', item: absoluteUrl('/spielzeit/') },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Aktuelle Produktionen 2026',
      itemListElement: productions.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: p.kind === 'maerchen'
          ? absoluteUrl('/weihnachtsmaerchen/')
          : absoluteUrl('/spielzeit/#' + slugify(p.title)),
      })),
    },
  ],
};
---

<BaseLayout
  meta={{
    title: `Spielzeit 2026 | ${site.name}`,
    description,
    canonicalPath: '/spielzeit/',
    ogImage: '/assets/img/og-spielzeit.png',
    ogImageAlt: 'Spielzeit 2026 — Volksbühne Worms',
  }}
  activeNav="spielzeit"
  bodyClass="page-spielzeit"
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Spielzeit' },
  ]}
  structuredData={structuredData}
>
  <section class="hero-inner" aria-labelledby="spielzeit-h1">
    <div class="container container--narrow" data-reveal>
      <p class="eyebrow">Spielzeit 2026</p>
      <h1 id="spielzeit-h1">Spielzeit 2026</h1>
      <p class="lead">
        Aktuelle Produktionen der Volksbühne Worms — Tickets direkt über Ticket-Regional.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Aktuelle Produktionen">
    <div class="container">
      <div class="card-grid card-grid--featured">
        {productions.map((prod, i) => (
          <div data-reveal style={`--reveal-delay: ${i + 1};`}>
            <ProductionCard production={prod} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="termine" aria-labelledby="termine-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Tickets &amp; Termine</p>
        <h2 id="termine-title">Vorstellungen der Spielzeit</h2>
        <p class="lead-compact">
          Alle Vorstellungen und Tickets der aktuellen Spielzeit finden
          Sie bei unserem Vorverkaufs-Partner Ticket-Regional.
        </p>
      </div>
      <div data-reveal>
        <ScheduleList groups={groups} />
      </div>
      <div class="actions" style="margin-top: var(--space-xl);" data-reveal>
        <a class="btn btn-primary btn-lg" href={site.spielzeitTicketUrl} rel="noopener">
          Alle Termine &amp; Tickets →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
