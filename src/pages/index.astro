---
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown.astro';
import { absoluteUrl, site, yearsActive } from '../data/site';
import { productions } from '../data/productions';

const years = yearsActive();

const spielzeitHighlights = [
  {
    eyebrow: 'Saisonstück 2026',
    title: productions[0].title,
    lead: productions[0].lead,
    image: productions[0].image,
    imageAlt: productions[0].imageAlt,
    ctaUrl: site.spielzeitTicketUrl,
    ctaLabel: 'Tickets kaufen',
    meta: 'Premiere 03.10.2026 · Volksbühne — kleines Theater',
  },
  {
    eyebrow: 'Nicht verpassen',
    title: 'Weihnachtsmärchen 2026 — Die Bremer Stadtmusikanten',
    lead: 'Ein Märchen der Brüder Grimm, in einer Inszenierung von Peter Schmitt.',
    image: productions[1].image,
    imageAlt: productions[1].imageAlt,
    ctaUrl: '/weihnachtsmaerchen/',
    ctaLabel: 'Mehr erfahren',
    meta: 'Vorstellungen 01. + 02.12.2026 · Das Wormser',
  },
];

// ItemList-Schema für die Spielzeit-Karten
const itemNames = ['Die Löffelliste', 'Weihnachtsmärchen 2026 — Die Bremer Stadtmusikanten'];
const itemListSchema = {
  '@type': 'ItemList',
  name: 'Aktuelle Spielzeit 2026',
  itemListElement: itemNames.map((name, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    url: i === 0 ? site.spielzeitTicketUrl : absoluteUrl('/weihnachtsmaerchen/'),
    image: absoluteUrl(productions[i].image),
  })),
};

const organizationSchema = {
  '@type': 'Organization',
  '@id': absoluteUrl('/') + '#organization',
  name: site.name,
  alternateName: 'VB Worms',
  url: absoluteUrl('/'),
  logo: absoluteUrl('/assets/img/vb-logo.png'),
  description:
    'Semiprofessionelles Theater in Worms seit 1908: Spielzeit, Weihnachtsmärchen und Kulturarbeit — handgemacht, nahbar, mit Herzblut.',
  foundingDate: String(site.foundingYear),
  email: site.email,
  telephone: site.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: '67549',
    addressLocality: 'Worms',
    addressCountry: site.address.country,
  },
  member: {
    '@type': 'QuantitativeValue',
    value: site.memberCount,
    unitText: 'Mitglieder',
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': absoluteUrl('/') + '#website',
  name: site.name,
  url: absoluteUrl('/'),
  inLanguage: 'de-DE',
  publisher: { '@id': absoluteUrl('/') + '#organization' },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
  ],
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, breadcrumbSchema, itemListSchema],
};
---

<BaseLayout
  meta={{
    title: `${site.name} — ${site.tagline}`,
    description:
      'Semiprofessionelles Theater in Worms seit 1908: Spielzeit, Weihnachtsmärchen und Kulturarbeit — handgemacht, nahbar, mit Herzblut.',
    canonicalPath: '/',
    ogImage: '/assets/img/og-home.png',
    ogImageAlt: 'Volksbühne Worms — Theater seit 1908',
  }}
  activeNav="home"
  bodyClass="page-home"
  structuredData={structuredData}
  preloadHero
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="hero__eyebrow">
            <span class="hero__eyebrow-dot" aria-hidden="true"></span>
            Tickets für das Weihnachtsmärchen verfügbar
          </p>
          <h1 id="hero-title">Theater in Worms,<br />seit 1908</h1>
          <p class="hero__tagline">Handgemacht, nahbar, mit Herzblut.</p>
          <p class="lead">
            Seit {site.foundingYear} begeistert die Volksbühne Worms Generationen mit einfallsreichem,
            mitreißendem Theater. Von Saisonstücken bis zum Weihnachtsmärchen: Kultur lebt hier nahbar
            und handgemacht.
          </p>

          <Countdown />

          <div class="actions">
            <a class="btn btn-primary btn-lg" href={site.maerchenTicketUrl} rel="noopener">Tickets bestellen</a>
            <a class="btn btn-secondary btn-lg" href="/spielzeit/">Spielzeit ansehen</a>
          </div>
        </div>
        <div class="hero-visual" data-reveal style="--reveal-delay: 1;">
          <figure class="poster">
            <img
              src="/assets/img/bsm.webp"
              width="1024"
              height="1536"
              alt="Titelbild des Weihnachtsmärchens 2026: Die Bremer Stadtmusikanten"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>Die Bremer Stadtmusikanten — ab 1. Dezember 2026, Das Wormser</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="spielzeit-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Aktuelle Spielzeit</p>
        <h2 id="spielzeit-title" class="visually-hidden">Aktuelle Spielzeit</h2>
        <p class="lead-compact">
          Saisonstück und Weihnachtsmärchen: zwei Inszenierungen, zwei Spielstätten — die Volksbühne live in Worms.
        </p>
      </div>

      <div class="card-grid card-grid--featured">
        {spielzeitHighlights.map((card, i) => (
          <div data-reveal style={`--reveal-delay: ${i + 1};`}>
            <article class="production-card">
              <a class="production-card__media" href={card.ctaUrl} aria-label={card.title}>
                <img src={card.image} alt={card.imageAlt} width="450" height="300" loading="lazy" decoding="async" />
                <span class="production-card__chips"><span class="chip">{card.eyebrow}</span></span>
              </a>
              <div class="production-card__body">
                <h2 class="production-card__title">{card.title}</h2>
                <p class="production-card__text">{card.lead.length > 220 ? card.lead.slice(0, 220).trimEnd() + '…' : card.lead}</p>              </div>
              <div class="production-card__footer">
                <span class="price-tag"><small>{card.meta.split('·')[0].trim()}</small>{card.meta.split('·')[1]?.trim()}</span>
                <a class="btn btn-primary btn-sm" href={card.ctaUrl} rel={card.ctaUrl.startsWith('http') ? 'noopener' : undefined}>
                  {card.ctaLabel}
                </a>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="verein-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Der Verein</p>
        <h2 id="verein-title">Seit {site.foundingYear} auf der Bühne.</h2>
        <p class="lead">
          Eingetragener Verein, gegründet {site.foundingYear}. Rund {site.memberCount} Mitglieder, mehr als
          {site.productionCount} Vorstellungen, zwei Spielstätten — handgemacht und nahbar.
        </p>
      </div>

      <div class="stat-row" data-reveal>
        <div class="stat-item">
          <span class="stat-number">{years}+</span>
          <span class="stat-label">Jahre aktiv</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">{site.memberCount}+</span>
          <span class="stat-label">Mitglieder</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">{site.productionCount}+</span>
          <span class="stat-label">Vorstellungen</span>
        </div>
      </div>

      <div class="actions" style="margin-top: var(--space-xl); justify-content: center;" data-reveal>
        <a class="btn btn-secondary" href="/verein/">Über den Verein erfahren →</a>
      </div>
    </div>
  </section>

  <section class="section section--brand" id="mitglied-werden-home" aria-labelledby="mitglied-title">
    <div class="container" style="max-width: 64rem;">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center" style="color: #fff;">Mitglied werden</p>
        <h2 id="mitglied-title">Mitgliedschaft</h2>
        <p class="lead">
          Seit 1908 gemeinnützig aktiv. Mitgliedsbeitrag {site.vereinBank.membershipFee} € jährlich,
          steuerlich absetzbar — und Teil einer starken Theatergemeinschaft in Worms.
        </p>
      </div>
      <div class="actions" style="justify-content: center; margin-top: var(--space-lg);" data-reveal>
        <a class="btn btn-light btn-lg" href="/verein/#mitglied-werden">Mitgliedschaft anfragen</a>
        <a class="btn btn-secondary btn-lg" href={`mailto:${site.email}?subject=Mitgliedschaft%20Volksb%C3%BChne%20Worms`}>
          Per E-Mail anfragen
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="kontakt-title">
    <div class="container container--narrow">
      <div class="contact-card contact-card--flow" data-reveal>
        <div>
          <p class="eyebrow">Kontakt</p>
          <h2 id="kontakt-title">Schreiben Sie uns.</h2>
          <p>Wir beantworten Anfragen zu Stücken, Mitgliedschaft und Vorstellungen schnell und persönlich.</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>E-Mail senden</a>
          <a class="btn btn-tertiary" href={`tel:${site.phoneHref}`}>Anrufen: {site.phoneDisplay}</a>
          <a class="btn btn-secondary" href="/kontakt/">Kontaktseite →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
