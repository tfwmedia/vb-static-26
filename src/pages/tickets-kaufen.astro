---
/**
 * /tickets-kaufen/ — Redirect-Stub zu Ticket-Regional.
 *
 * Auf dem Live-Server (Apache) übernimmt public/.htaccess den echten
 * 301-Redirect, bevor diese Seite erreicht wird. Diese Seite dient als
 * Fallback für statische Hosts ohne Rewrite-Engine (und für den lokalen
 * Preview): Meta-Refresh mit 0 Sekunden gilt bei Suchmaschinen als
 * permanente Weiterleitung; zusätzlich noindex.
 *
 * Ziel (Quelle der Wahrheit, wie in src/data/site.ts → spielzeitTicketUrl):
 * Eventtyp-Übersicht 1883 auf ticket-regional.de.
 */
const ticketUrl =
  'https://www.ticket-regional.de/events.php?mysearchSpecificType=eventtype&mysearchSpecificID=1883';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={ticketUrl} />
    <meta http-equiv="refresh" content={`0; url=${ticketUrl}`} />
    <title>Weiterleitung zu Ticket-Regional — Volksbühne Worms 1908 e. V.</title>
    <style is:global>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        display: grid;
        place-items: center;
        min-height: 100vh;
        margin: 0;
        background: #faf9f7;
        color: #1a1a1a;
        text-align: center;
        padding: 2rem;
      }

      a {
        color: #c31e2e;
      }
    </style>
  </head>
  <body>
    <main>
      <p>Sie werden zum Ticket-Shop weitergeleitet …</p>
      <p>
        Falls Sie nicht weitergeleitet werden:
        <a href={ticketUrl} rel="noopener">Tickets auf ticket-regional.de kaufen</a>
      </p>
    </main>
  </body>
</html>
