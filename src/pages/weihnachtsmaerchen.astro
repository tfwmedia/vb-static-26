---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, site } from '../data/site';

const description =
  'Die Bremer Stadtmusikanten: Weihnachtsmärchen 2026 der Volksbühne Worms am 01.12. und 02.12.2026 in Das Wormser.';

const wormserAddress = {
  '@type': 'PostalAddress',
  streetAddress: 'Rathenaustraße 11',
  postalCode: '67549',
  addressLocality: 'Worms',
  addressCountry: 'DE',
};

const subEvent = (date: string) => ({
  '@type': 'Event',
  name: 'Die Bremer Stadtmusikanten — Vorstellung',
  startDate: `${date}T18:00:00+01:00`,
  endDate: `${date}T20:30:00+01:00`,
  location: { '@type': 'Place', name: 'Das Wormser', address: wormserAddress },
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  offers: {
    '@type': 'Offer',
    url: site.maerchenTicketUrl,
    price: '12.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
  performer: { '@type': 'PerformingGroup', name: site.name },
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'PerformingGroup',
      name: site.name,
      url: absoluteUrl('/'),
      additionalType: 'LocalBusiness',
      email: site.email,
      telephone: site.phoneDisplay,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        postalCode: '67549',
        addressLocality: 'Worms',
        addressCountry: 'DE',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Spielzeit', item: absoluteUrl('/spielzeit/') },
        { '@type': 'ListItem', position: 3, name: 'Weihnachtsmärchen 2026', item: absoluteUrl('/weihnachtsmaerchen/') },
      ],
    },
    {
      '@type': 'EventSeries',
      name: 'Weihnachtsmärchen 2026: Die Bremer Stadtmusikanten',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: 'Das Wormser', address: wormserAddress },
      organizer: { '@type': 'Organization', name: site.name, url: absoluteUrl('/') },
      offers: {
        '@type': 'Offer',
        price: '12.00',
        priceCurrency: 'EUR',
        url: site.maerchenTicketUrl,
        availability: 'https://schema.org/InStock',
        validFrom: '2026-08-01T00:00:00+02:00',
      },
      subEvent: [subEvent('2026-12-01'), subEvent('2026-12-02')],
    },
  ],
};
---

<BaseLayout
  meta={{
    title: 'Weihnachtsmärchen 2026 | Die Bremer Stadtmusikanten',
    description,
    canonicalPath: '/weihnachtsmaerchen/',
    ogType: 'article',
    ogImage: '/assets/img/og-maerchen.svg',
    ogImageAlt: 'Weihnachtsmärchen 2026 — Die Bremer Stadtmusikanten',
  }}
  activeNav="maerchen"
  bodyClass="page-maerchen"
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Spielzeit', href: '/spielzeit/' },
    { label: 'Weihnachtsmärchen 2026' },
  ]}
  structuredData={structuredData}
>
  <section class="hero-inner" aria-labelledby="maerchen-h1">
    <div class="container hero-grid hero-grid--side">
      <div data-reveal>
        <p class="eyebrow">Weihnachtsmärchen 2026</p>
        <h1 id="maerchen-h1">Die Bremer Stadtmusikanten</h1>
        <p class="lead">
          Ein Märchen der Brüder Grimm.<br />
          In einer Inszenierung von Peter Schmitt.
        </p>
        <div class="actions" style="margin-top: var(--space-lg);">
          <a class="btn btn-primary" href={site.maerchenTicketUrl} rel="noopener">Tickets bestellen</a>
          <a class="btn btn-secondary" href={`mailto:${site.maerchenContactEmail}`}>Kontakt für Gruppen</a>
          <a class="btn btn-tertiary" href={`tel:${site.maerchenContactPhoneHref}`}>Anrufen: {site.maerchenContactPhoneDisplay}</a>
        </div>
      </div>
      <figure class="poster" data-reveal style="--reveal-delay: 1;">
        <img
          src="/assets/img/bsm.webp"
          width="1024"
          height="1536"
          alt="Titelmotiv des Weihnachtsmärchens 2026: Die Bremer Stadtmusikanten"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Die Bremer Stadtmusikanten — Weihnachtsmärchen 2026</figcaption>
      </figure>
    </div>

    <div class="container event-strip-wrap">
      <dl class="event-strip" data-reveal>
        <div>
          <dt>Datum</dt>
          <dd>
            <time datetime="2026-12-01">Dienstag, 01.12.2026</time>, 18:00 Uhr<br />
            <time datetime="2026-12-02">Mittwoch, 02.12.2026</time>, 18:00 Uhr
          </dd>
        </div>
        <div>
          <dt>Ort</dt>
          <dd>Das Wormser,<br />Rathenaustraße 11, 67549 Worms</dd>
        </div>
        <div>
          <dt>Tickets</dt>
          <dd><strong>12,00 €</strong></dd>
        </div>
        <div class="event-strip__cta">
          <a class="btn btn-primary" href={site.maerchenTicketUrl} rel="noopener">Tickets bestellen</a>
        </div>
      </dl>
      <p class="strip-note" data-reveal>
        Der Vorverkauf gilt für die frei verkäuflichen Vorstellungen am
        01. und 02.12.2026. Geschlossene Vorstellungen für Schulklassen und
        Kindergärten sind darin nicht enthalten — Informationen dazu finden Sie
        <a href="#schulvorstellungen">weiter unten auf dieser Seite</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose" data-reveal>
      <h2>Inhalt</h2>
      <p>
        In dem Märchen "Die Bremer Stadtmusikanten" schließen sich ein alter Esel, ein Hund,
        eine Katze und ein Hahn zusammen, nachdem ihre Besitzer sie loswerden wollen.
        Gemeinsam machen sie sich auf den Weg nach Bremen, um dort Stadtmusikanten zu werden.
      </p>
      <p>
        Unterwegs vertreiben sie mit Mut und Zusammenhalt eine Räuberbande aus einem Haus im Wald
        und finden dort schließlich ein neues Zuhause - und eine starke Freundschaft.
      </p>
      <p>
        Die Volksbühne Worms 1908 e. V. freut sich, in der Vorweihnachtszeit wieder ein
        Märchen für Groß und Klein auf die Bühne zu bringen.
      </p>
    </div>
  </section>

  <section class="section section--alt" id="schulvorstellungen" aria-labelledby="schulen-title">
    <div class="container container--narrow">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Für Schulklassen &amp; Kindergärten</p>
        <h2 id="schulen-title">Geschlossene Vorstellungen ab Montagvormittag</h2>
        <p class="lead-compact">
          Ab Montagvormittag spielen wir täglich zwei geschlossene Vorstellungen
          des Weihnachtsmärchens für Schulklassen und Kindergärten. Diese
          Vorstellungen sind nicht frei verkäuflich — Karten gibt es ausschließlich
          über die Anmeldung bei unserem Märchen-Team.
        </p>
      </div>
      <div class="actions" data-reveal>
        <a class="btn btn-primary" href={`mailto:${site.maerchenContactEmail}?subject=${encodeURIComponent('Anfrage Schulvorstellung Weihnachtsmärchen 2026')}`}>
          Schulvorstellung anfragen
        </a>
        <a class="btn btn-tertiary" href={`tel:${site.maerchenContactPhoneHref}`}>Anrufen: {site.maerchenContactPhoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="section" id="anfahrt" aria-labelledby="anfahrt-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Anfahrt</p>
        <h2 id="anfahrt-title">Das Wormser in Worms</h2>
        <p class="lead-compact">
          Alle Vorstellungen des Weihnachtsmärchens finden im Kulturzentrum
          Das Wormser statt, Rathenaustraße 11 in 67549 Worms.
        </p>
      </div>
      <div class="container--narrow">
        <article class="place-card" data-reveal>
          <div class="place-card__body">
            <p class="eyebrow" style="margin-bottom: 0;">Kulturzentrum</p>
            <h3 class="place-card__title">Das Wormser</h3>
            <address class="place-card__address">Rathenaustraße 11<br />67549 Worms</address>
            <p class="place-card__note">
              Tickets gibt es online über Ticket-Regional für die frei
              verkäuflichen Vorstellungen. Gruppenanfragen für Kindergärten
              und Schulklassen nimmt unser Märchen-Team direkt entgegen.
            </p>
            <div class="actions" style="margin-top: var(--space-sm);">
              <a class="btn btn-primary btn-sm" href={site.maerchenTicketUrl} rel="noopener">Tickets bestellen</a>
              <a class="btn btn-secondary btn-sm" href={`mailto:${site.maerchenContactEmail}`}>Gruppenanfrage</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="gruppe-title">
    <div class="container container--narrow">
      <div class="contact-card contact-card--flow" data-reveal>
        <div>
          <p class="eyebrow">Sie möchten mit einer Gruppe kommen?</p>
          <h2 id="gruppe-title">Wir helfen gerne weiter.</h2>
          <p>
            Kontakt für Kindergärten und Schulklassen: {site.maerchenContactEmail},
            {site.maerchenContactPhoneDisplay}.
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.maerchenContactEmail}`}>E-Mail senden</a>
          <a class="btn btn-tertiary" href={`tel:${site.maerchenContactPhoneHref}`}>Anrufen</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
