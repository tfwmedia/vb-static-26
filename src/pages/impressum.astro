---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, site } from '../data/site';
import { loadLegalHtml } from '../lib/legal';

const legal = loadLegalHtml('impressum');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Impressum', item: absoluteUrl('/impressum/') },
      ],
    },
  ],
};
---

<BaseLayout
  meta={{
    title: `Impressum | ${site.name}`,
    description:
      'Impressum der Volksbühne Worms 1908 e. V.: Anschrift, Vertretungsberechtigte, Vereinsregister und Bankverbindungen.',
    canonicalPath: '/impressum/',
    ogImage: '/assets/img/og-image.svg',
    ogImageAlt: site.name,
  }}
  bodyClass="page-impressum"
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Impressum' },
  ]}
  structuredData={structuredData}
>
  <section class="hero-inner" aria-labelledby="impressum-h1">
    <div class="container container--narrow" data-reveal>
      <p class="eyebrow">Rechtliches</p>
      <h1 id="impressum-h1">Impressum</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow legal" data-reveal set:html={legal} />
  </section>
</BaseLayout>
