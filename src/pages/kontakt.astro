---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, site } from '../data/site';

const description =
  'Kontakt und Anfahrt zur Volksbühne Worms 1908 e. V.: Vereinsadresse, beide Spielstätten, Telefon, E-Mail.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: 'Kontakt',
      description,
      url: absoluteUrl('/kontakt/'),
      isPartOf: { '@id': absoluteUrl('/') + '#website' },
      publisher: { '@id': absoluteUrl('/') + '#organization' },
      mainEntity: { '@id': absoluteUrl('/') + '#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Kontakt', item: absoluteUrl('/kontakt/') },
      ],
    },
  ],
};
---

<BaseLayout
  meta={{
    title: `Kontakt | ${site.name}`,
    description,
    canonicalPath: '/kontakt/',
    ogImage: '/assets/img/og-kontakt.png',
    ogImageAlt: 'Kontakt — Volksbühne Worms',
  }}
  activeNav="kontakt"
  bodyClass="page-kontakt"
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Kontakt' },
  ]}
  structuredData={structuredData}
>
  <section class="hero-inner" aria-labelledby="kontakt-h1">
    <div class="container container--narrow" data-reveal>
      <p class="eyebrow">Kontakt</p>
      <h1 id="kontakt-h1">So erreichst du uns.</h1>
      <p class="lead">
        Postanschrift des Vereins, unsere beiden Spielstätten und die direkten Kontaktwege
        — Telefon, E-Mail und Vorverkaufs-Partner.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="kanaele-title">
    <div class="container card-grid">
      <article class="contact-card" data-reveal>
        <div>
          <p class="eyebrow">Vereinsadresse</p>
          <h2 id="kanaele-title">Volksbühne Worms 1908 e. V.</h2>
          <address style="font-style: normal;">
            Würdtweinstraße 11<br />
            67549 Worms
          </address>
          <p style="margin-top: var(--space-md);">
            <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>E-Mail senden</a>
          <a class="btn btn-tertiary" href={`tel:${site.phoneHref}`}>Anrufen</a>
        </div>
      </article>

      <article class="contact-card" data-reveal>
        <div>
          <p class="eyebrow">Märchen-Kontakt</p>
          <h2>Gruppen, Schulen &amp; Kindergärten</h2>
          <p>
            Für Gruppenanfragen zum Weihnachtsmärchen:<br />
            <a href={`mailto:${site.maerchenContactEmail}`}>{site.maerchenContactEmail}</a><br />
            <a href={`tel:${site.maerchenContactPhoneHref}`}>{site.maerchenContactPhoneDisplay}</a>
          </p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.maerchenContactEmail}`}>E-Mail senden</a>
          <a class="btn btn-tertiary" href={`tel:${site.maerchenContactPhoneHref}`}>Anrufen</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="spielstaetten-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Spielstätten</p>
        <h2 id="spielstaetten-title">Zwei Häuser — eine Bühne</h2>
        <p class="lead-compact">
          Das <strong>Saisonstück</strong> spielen wir in unserem eigenen Kleinen Theater.
          Das <strong>Weihnachtsmärchen</strong> hat im Wormser Kulturzentrum sein Zuhause.
        </p>
      </div>

      <div class="card-grid card-grid--featured">
        <article class="place-card" data-reveal>
          <div class="place-card__body">
            <p class="eyebrow" style="margin-bottom: 0;">Saisonstück</p>
            <h3 class="place-card__title">Volksbühne — kleines Theater</h3>
            <address class="place-card__address">
              Würdtweinstraße 11<br />
              67549 Worms
            </address>
            <p class="place-card__note">Unser eigenes Haus — gleiche Adresse wie die Vereinsadresse.</p>
          </div>
        </article>

        <article class="place-card" data-reveal style="--reveal-delay: 1;">
          <div class="place-card__body">
            <p class="eyebrow" style="margin-bottom: 0;">Weihnachtsmärchen</p>
            <h3 class="place-card__title">Das Wormser — Kulturzentrum</h3>
            <address class="place-card__address">
              Rathenaustraße 11<br />
              67549 Worms
            </address>
            <p style="margin: var(--space-sm) 0 0;">
              <a href={site.maerchenTicketUrl} class="btn btn-secondary btn-sm" rel="noopener">Termine ansehen →</a>
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="post-title">
    <div class="container container--narrow">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow eyebrow--center" style="color: #fff;">Postanschrift</p>
        <h2 id="post-title">Volksbühne Worms 1908 e. V.</h2>
      </div>
      <div class="contact-card" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.18); color: inherit;" data-reveal>
        <address style="font-style: normal; font-size: 1.125rem;">
          Volksbühne Worms 1908 e. V.<br />
          Würdtweinstraße 11<br />
          67549 Worms
        </address>
      </div>
    </div>
  </section>
</BaseLayout>
