---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { absoluteUrl, metaDefaults, site, type PageMeta } from '../data/site';

interface Props {
  meta: PageMeta;
  activeNav?: string;
  breadcrumbs?: Crumb[];
  structuredData?: Record<string, unknown> | null;
  bodyClass?: string;
  /** Hero-Bild der Startseite hochpriorisiert vorladen. */
  preloadHero?: boolean;
}

const { meta, activeNav = '', breadcrumbs = [], structuredData = null, bodyClass = '', preloadHero = false } = Astro.props;

const canonical = absoluteUrl(meta.canonicalPath);
const ogImage = absoluteUrl(meta.ogImage ?? metaDefaults.ogImage);
const title = meta.title;
const description = meta.description;
const robots = meta.robots ?? metaDefaults.robots;
const ogType = meta.ogType ?? metaDefaults.ogType;
const ogImageAlt = meta.ogImageAlt ?? site.name;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={metaDefaults.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={metaDefaults.ogImageWidth} />
    <meta property="og:image:height" content={metaDefaults.ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={metaDefaults.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" href="/assets/img/vb-icon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/img/vb-logo.png" />

    {preloadHero && <link rel="preload" href="/assets/img/bsm.webp" as="image" fetchpriority="high" />}
    <link rel="preload" href="/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/js/site.js" defer></script>

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Direkt zum Inhalt</a>
    <SiteHeader activeNav={activeNav} />

    {breadcrumbs.length > 0 && (
      <div class="container breadcrumb-wrap">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    )}

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
